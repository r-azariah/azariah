<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Azariah.App.ViewModels"
             xmlns:app="using:Azariah.App"
             x:Class="Azariah.App.Views.GuestView"
             x:DataType="vm:GuestViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.key">
      <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="{DynamicResource AzSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AzBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource AzCardRadius}" />
      <Setter Property="Padding" Value="20,18" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AzAccentBrush}" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.row:pointerover TextBlock.name">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <!-- Home: greeting + tiles -->
  <ScrollViewer IsVisible="{Binding IsHome}">
    <StackPanel Spacing="34" Margin="48,56,48,40" MaxWidth="1040" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Text="HELLO" FontSize="76" FontWeight="Bold" LetterSpacing="2" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="From" FontSize="20" Classes="key" VerticalAlignment="Center" />
          <Path Data="{x:Static app:Brand.Wordmark}" Fill="{DynamicResource AzTextBrush}" Stretch="Uniform"
                Height="22" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="key" Margin="0,6,0,0"
                   Text="You're on a PC that isn't one of Azariah's. Here's what you can do." />
        <TextBlock Classes="danger" FontSize="13" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:GuestTile">
            <Button Classes="tile" Width="320" Margin="0,0,16,16" Command="{Binding Command}">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <Border Grid.Column="1" Background="{DynamicResource AzAccentSoftBrush}" CornerRadius="999" Padding="8,2"
                        VerticalAlignment="Top" IsVisible="{Binding HasBadge}">
                  <TextBlock Text="{Binding Badge}" FontSize="11" Classes="key" />
                </Border>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Classes="key" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>

  <!-- Storage: friendly categories as bars, click one to see its files -->
  <Grid IsVisible="{Binding IsStorage}" RowDefinitions="Auto,Auto,*" Margin="48,40,48,28">
    <Button Classes="ghost" Content="&#x2190;  Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
    <StackPanel Grid.Row="1" Spacing="4" Margin="0,16,0,14">
      <TextBlock Classes="h1" Text="Storage" />
      <TextBlock Classes="key" Text="{Binding ScanText}" />
    </StackPanel>

    <!-- Overview: category bars -->
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsOverview}">
      <ItemsControl ItemsSource="{Binding Categories}" MaxWidth="860" HorizontalAlignment="Left">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:GuestCategory">
            <Button Classes="row" Margin="0,7" Padding="0,2"
                    Command="{Binding $parent[UserControl].((vm:GuestViewModel)DataContext).OpenCategoryCommand}" CommandParameter="{Binding}">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto,120">
                  <TextBlock Classes="name" Text="{Binding Name}" FontSize="15" FontWeight="Medium" />
                  <TextBlock Grid.Column="1" Classes="key" FontSize="12" Text="{Binding CountText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Width="460" Height="10" CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource AzHoverBrush}">
                  <Border Width="{Binding BarWidth}" CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource AzAccentBrush}" />
                </Border>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Drill-in: one category's biggest files -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding !IsOverview}">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
        <Button Classes="ghost" Content="&#x2190;  All storage" Command="{Binding BackToOverviewCommand}" />
        <TextBlock Classes="h3" VerticalAlignment="Center" Text="{Binding Opened.Name}" />
      </StackPanel>
      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Opened.Files}" MaxWidth="1040" HorizontalAlignment="Left">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:SpaceFileItem">
              <Grid ColumnDefinitions="*,110,Auto" Margin="0,3">
                <StackPanel Spacing="1">
                  <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="key" FontSize="12" Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost" Content="Show" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:GuestViewModel)DataContext).OpenFileCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>

  <!-- Shared files (Setup Kit) -->
  <Grid IsVisible="{Binding IsShared}" RowDefinitions="Auto,*" Margin="48,40,28,20">
    <Button Classes="ghost" Content="&#x2190;  Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
    <ContentControl Grid.Row="1" Content="{Binding Shared}" />
  </Grid>

  <!-- Locked: too many unlock attempts -->
  <Border IsVisible="{Binding IsLocked}" Background="{DynamicResource AzWindowBrush}">
    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Data="{x:Static app:Brand.Mark}" Fill="{DynamicResource AzTextBrush}" Stretch="Uniform" Height="44" HorizontalAlignment="Center" />
      <TextBlock Text="Locked" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Classes="key" HorizontalAlignment="Center" Text="Too many attempts." />
      <TextBlock Classes="key" HorizontalAlignment="Center" Text="{Binding LockText}" />
    </StackPanel>
  </Border>

  <!-- Test-mode banner (stays on top of the locked screen so you can always get out) -->
  <Border IsVisible="{Binding IsPreview}" VerticalAlignment="Top" Background="{DynamicResource AzAccentSoftBrush}" Padding="48,9">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Classes="key" VerticalAlignment="Center" Text="Test mode. Nothing is really ejected or locked." />
      <TextBlock Grid.Column="1" Classes="key" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding TestLeftText}" />
      <Button Grid.Column="2" Classes="ghost" Content="Exit test" Command="{Binding ExitPreviewCommand}" />
    </Grid>
  </Border>
  </Panel>
</UserControl>
