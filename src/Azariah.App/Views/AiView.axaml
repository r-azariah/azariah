<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Azariah.App.ViewModels"
             x:Class="Azariah.App.Views.AiView"
             x:DataType="vm:AiViewModel">
  <ScrollViewer>
    <StackPanel Margin="36,24" Spacing="20" MaxWidth="860" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource AzAccentSoftBrush}">
          <mi:MaterialIcon Kind="RobotOutline" Width="26" Height="26" Foreground="{DynamicResource AzAccentBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="eyebrow" Text="PHASE 7" Foreground="{DynamicResource AzAccentBrush}" />
          <TextBlock Classes="h1" Text="AZARIAH Assistant" />
        </StackPanel>
      </Grid>

      <Border Classes="card" Padding="24">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Your own JARVIS, minus the voice" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Ask questions, hit a hotkey to have it look at your screen, search your drive and Roblox projects, explain Luau, summarize docs and open files. Its brain is swappable: Claude Desktop through MCP (runs on your Claude plan), a local model on your PC, or a cloud API." />
        </StackPanel>
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="PERMISSIONS  ·  EACH ONE IS SWITCHED ON SEPARATELY" />
        <ItemsControl ItemsSource="{Binding Capabilities}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CapabilityRow">
              <Border Classes="card" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource AzAccentBrush}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Margin="12,0" Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" IsChecked="False" IsEnabled="False" OnContent="" OffContent="" VerticalAlignment="Top" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
