<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="using:Azariah.App.ViewModels.Dialogs"
             x:Class="Azariah.App.Views.Dialogs.ConfirmDialogView"
             x:DataType="dvm:ConfirmDialogViewModel">
  <StackPanel Spacing="14">
    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
    <Border Background="{DynamicResource AzSurfaceAltBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding HasDetails}">
      <ItemsControl ItemsSource="{Binding Details}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="dvm:DetailRow">
            <Grid ColumnDefinitions="130,*" Margin="0,3">
              <TextBlock Text="{Binding Label}" Classes="faint" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" Classes.warning="{Binding IsWarning}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}" />
      <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True"
              Classes.primary="{Binding !IsDanger}" Classes.danger="{Binding IsDanger}" />
    </StackPanel>
  </StackPanel>
</UserControl>
