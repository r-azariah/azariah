<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="using:Azariah.App.ViewModels.Dialogs"
             x:Class="Azariah.App.Views.Dialogs.PromptDialogView"
             x:DataType="dvm:PromptDialogViewModel">
  <StackPanel Spacing="14">
    <TextBlock Classes="h2" Text="{Binding Title}" />
    <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap"
               IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBox x:Name="Input" Text="{Binding Text}" PlaceholderText="{Binding Watermark}">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
      </TextBox.KeyBindings>
    </TextBox>
    <TextBlock Classes="danger" FontSize="12" Text="{Binding Error}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
