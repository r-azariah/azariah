<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Azariah.App.ViewModels"
        xmlns:v="using:Azariah.App.Views"
        x:Class="Azariah.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/azariah.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <!-- Native Windows title bar for now. A custom one comes with the redesign (see docs/DESIGN.md). -->
  <Grid>
    <ContentControl Content="{Binding Current}" />

    <!-- Dialog overlay -->
    <Border x:Name="DialogOverlay" Background="{DynamicResource AzOverlayBrush}"
            IsVisible="{Binding Dialogs.Active, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card" MaxWidth="560" MinWidth="380" Margin="24" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl Content="{Binding Dialogs.Active}" />
      </Border>
    </Border>

    <!-- [A] open / disconnect animation -->
    <v:BootOverlay x:Name="Boot" />
  </Grid>
</Window>
