<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Azariah.App.ViewModels"
             x:Class="Azariah.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="36,24" Spacing="18" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Spacing="2">
        <TextBlock Classes="eyebrow" Text="AZARIAH" />
        <TextBlock Classes="h1" Text="Settings" />
      </StackPanel>

      <!-- Auto-launch -->
      <Border Classes="card" Padding="22">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AzAccentSoftBrush}" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="RocketLaunchOutline" Width="22" Height="22" Foreground="{DynamicResource AzAccentBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0" Spacing="4">
            <TextBlock Classes="eyebrow" Text="AUTO-LAUNCH ON THIS PC" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource AzSuccessBrush}" IsVisible="{Binding AutoLaunchOn}" VerticalAlignment="Center" />
              <TextBlock Classes="h2" Text="{Binding AutoLaunchTitle}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding AutoLaunchDetail}" />
            <TextBlock Classes="faint" FontSize="11" Margin="0,4,0,0">
              <Run Text="This PC: " />
              <Run Text="{Binding MachineName}" />
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top" IsVisible="{Binding AutoLaunchSupported}">
            <Button Classes="primary" Content="Turn on" Command="{Binding EnableAutoLaunchCommand}"
                    IsVisible="{Binding !AutoLaunchOn}" IsEnabled="{Binding !IsWorking}" />
            <Button Classes="primary" Content="Update this PC" Command="{Binding UpdateLocalCopyCommand}"
                    IsVisible="{Binding CanUpdateLocalCopy}" IsEnabled="{Binding !IsWorking}" />
            <Button Content="Turn off" Command="{Binding DisableAutoLaunchCommand}"
                    IsVisible="{Binding AutoLaunchOn}" IsEnabled="{Binding !IsWorking}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Drive -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Classes="eyebrow" Text="DRIVE" />
          <Grid ColumnDefinitions="140,*,Auto">
            <TextBlock Classes="label" Text="Name" />
            <TextBox Grid.Column="1" Text="{Binding DriveName}" MaxLength="40" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
            <Button Grid.Column="2" Content="Save" Command="{Binding SaveDriveNameCommand}" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Connected at" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding RootText}" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Format" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding VolumeText}" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Drive id" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding DriveIdText}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding OpenTrashCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" /><TextBlock Text="Open Trash" /></StackPanel>
            </Button>
            <Button Command="{Binding RepairFoldersCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16" /><TextBlock Text="Recreate missing folders" /></StackPanel>
            </Button>
            <Button Command="{Binding OpenLogsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" /><TextBlock Text="Logs" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Look + files -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Classes="eyebrow" Text="APPEARANCE AND FILES" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="value" Text="Theme" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinWidth="140" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="value" Text="Show hidden files" />
              <TextBlock Classes="muted" FontSize="12" Text="Includes system files Windows keeps on the drive." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHiddenFiles}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="value" Text="Ask before moving to Trash" />
              <TextBlock Classes="muted" FontSize="12" Text="Deleting forever from Trash always asks." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmMoveToTrash}" OnContent="" OffContent="" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Security (coming) -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="12">
          <TextBlock Classes="eyebrow" Text="SECURITY" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="value" Text="Vault auto-lock" />
              <TextBlock Classes="muted" FontSize="12" Text="Lock after inactivity. Arrives with the Vault (Phase 2)." />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill"><TextBlock Text="Soon" FontSize="11" Classes="accent" /></Border>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="value" Text="Trusted computers" />
              <TextBlock Classes="muted" FontSize="12" Text="Pair, view and revoke PCs that can unlock without your password (Phase 3)." />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill"><TextBlock Text="Soon" FontSize="11" Classes="accent" /></Border>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="faint" FontSize="11">
        <Run Text="AZARIAH " />
        <Run Text="{Binding VersionText}" />
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>
