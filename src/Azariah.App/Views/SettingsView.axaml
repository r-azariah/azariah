<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Azariah.App.ViewModels"
             x:Class="Azariah.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="24,24,40,32" Spacing="36" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Settings" />

      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Auto-launch on this PC" />
        <Grid ColumnDefinitions="140,*,Auto">
          <TextBlock Classes="label" Text="{Binding MachineName}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding AutoLaunchTitle}" />
            <TextBlock Classes="label" Text="{Binding AutoLaunchDetail}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" IsVisible="{Binding AutoLaunchSupported}">
            <Button Classes="primary" Content="Turn on" Command="{Binding EnableAutoLaunchCommand}"
                    IsVisible="{Binding !AutoLaunchOn}" IsEnabled="{Binding !IsWorking}" />
            <Button Classes="primary" Content="Update this PC" Command="{Binding UpdateLocalCopyCommand}"
                    IsVisible="{Binding CanUpdateLocalCopy}" IsEnabled="{Binding !IsWorking}" />
            <Button Content="Turn off" Command="{Binding DisableAutoLaunchCommand}"
                    IsVisible="{Binding AutoLaunchOn}" IsEnabled="{Binding !IsWorking}" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Drive" />
        <Grid ColumnDefinitions="140,*,Auto">
          <TextBlock Classes="label" Text="Name" />
          <TextBox Grid.Column="1" Text="{Binding DriveName}" MaxLength="40" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
          <Button Grid.Column="2" Content="Save" Command="{Binding SaveDriveNameCommand}" />
        </Grid>
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Location" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding RootText}" />
        </Grid>
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Format" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding VolumeText}" />
        </Grid>
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Drive id" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding DriveIdText}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="140,4,0,0">
          <Button Content="Trash" Command="{Binding OpenTrashCommand}" />
          <Button Content="Recreate missing folders" Command="{Binding RepairFoldersCommand}" />
          <Button Content="Logs" Command="{Binding OpenLogsCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Display" />
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Theme" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinWidth="140" />
        </Grid>
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Hidden files" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHiddenFiles}" OnContent="Shown" OffContent="Hidden" />
        </Grid>
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="label" Text="Trash" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmMoveToTrash}" OnContent="Ask first" OffContent="Don't ask" />
        </Grid>
      </StackPanel>

      <TextBlock Classes="faint" FontSize="11">
        <Run Text="AZARIAH " />
        <Run Text="{Binding VersionText}" />
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>
