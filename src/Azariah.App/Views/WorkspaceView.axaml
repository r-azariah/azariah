<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Azariah.App.ViewModels"
             x:Class="Azariah.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <Grid ColumnDefinitions="200,*">
    <!-- Sidebar: mark, drive, places. Interim layout until the redesign lands. -->
    <Grid RowDefinitions="Auto,*" Margin="24,24,12,20">
      <StackPanel Spacing="14" Margin="12,0,0,28">
        <Path Data="{StaticResource AzMark}" Fill="{DynamicResource AzTextBrush}" Stretch="Uniform"
              Width="34" Height="27" HorizontalAlignment="Left" />
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding DriveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding RootText}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootText}" />
        </StackPanel>
      </StackPanel>

      <ListBox Grid.Row="1" Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:NavItem">
            <TextBlock Text="{Binding Title}" FontWeight="Medium" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- Drive removed -->
    <Border Grid.ColumnSpan="2" Background="{DynamicResource AzOverlayBrush}" IsVisible="{Binding IsDisconnected}">
      <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="Drive removed" />
        <TextBlock Classes="muted" Text="Plug it back in to continue." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
