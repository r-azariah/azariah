<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Azariah.App.ViewModels"
             x:Class="Azariah.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.key">
      <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row:pointerover TextBlock.name">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <!-- Interim Home: current state as lists, no cards. The redesign replaces this (docs/DESIGN.md). -->
  <ScrollViewer>
    <Grid ColumnDefinitions="*,56,300" Margin="24,24,40,32" MaxWidth="1240">
      <StackPanel Spacing="4">
        <StackPanel Spacing="4" IsVisible="{Binding HasGames}" Margin="0,0,0,32">
          <TextBlock Classes="h1" Text="Games" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RobloxProjectViewModel">
                <Grid ColumnDefinitions="*,220,Auto">
                  <Button Classes="row" Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="name" Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="key" Text="{Binding PassText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="1" Classes="key" Text="{Binding ListDetail}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Classes="ghost" Content="Open in Studio" IsVisible="{Binding HasLatest}" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenGameInStudioCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Classes="h1" Text="Recent" Margin="0,0,0,10" />
        <TextBlock Classes="muted" Text="Nothing opened yet." IsVisible="{Binding !HasRecent}" />
        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:FileItemViewModel">
              <Button Classes="row"
                      Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Show in Files" Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).ShowRecentInFilesCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="*,220,90">
                  <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding LocationText}" Classes="key" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding AgoText}" Classes="key" HorizontalAlignment="Right" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="28">
        <StackPanel Spacing="8">
          <TextBlock Classes="h3" Text="{Binding DriveName}" />
          <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="3" CornerRadius="0" />
          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" >
            <TextBlock Classes="key" Text="Used" />
            <TextBlock Grid.Column="1" Classes="val" Text="{Binding UsedText}" />
            <TextBlock Grid.Row="1" Classes="key" Text="Free" Margin="0,4,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding FreeText}" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Classes="key" Text="Drive" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="val" Text="{Binding RootText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootText}" />
          </Grid>
        </StackPanel>

        <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Classes="key" Text="Vault" />
          <TextBlock Grid.Column="1" Classes="val" Text="Not set up" />
          <TextBlock Grid.Row="1" Classes="key" Text="This PC" Margin="0,4,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding MachineName}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="2" Classes="key" Text="Auto-launch" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="1" Classes="row" Padding="0" Margin="0,4,0,0"
                  Command="{Binding GoCommand}" CommandParameter="settings" HorizontalAlignment="Left">
            <TextBlock Classes="val name" Text="{Binding AutoLaunchText}" />
          </Button>
          <TextBlock Grid.Row="3" Classes="key" Text="Transfer" Margin="0,4,0,0" />
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="val" Text="{Binding TransferText}" Margin="0,4,0,0" />
        </Grid>

        <StackPanel Spacing="0">
          <TextBlock Classes="key" Text="Go to" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Locations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:HomeLocation">
                <Button Classes="row" Padding="0,3"
                        Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenLocationCommand}" CommandParameter="{Binding}">
                  <TextBlock Classes="val name" Text="{Binding Title}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
