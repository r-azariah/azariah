<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- AZARIAH palette. Every surface uses these tokens so Dark and Light stay in sync. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AzWindowBrush" Color="#000000" />
      <SolidColorBrush x:Key="AzSidebarBrush" Color="#000000" />
      <SolidColorBrush x:Key="AzSurfaceBrush" Color="#0D0D0D" />
      <SolidColorBrush x:Key="AzSurfaceAltBrush" Color="#141414" />
      <SolidColorBrush x:Key="AzHoverBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="AzBorderBrush" Color="#262626" />
      <SolidColorBrush x:Key="AzTextBrush" Color="#EDEDEA" />
      <SolidColorBrush x:Key="AzMutedBrush" Color="#9A9A96" />
      <SolidColorBrush x:Key="AzFaintBrush" Color="#63635F" />
      <SolidColorBrush x:Key="AzAccentBrush" Color="#EDEDEA" />
      <SolidColorBrush x:Key="AzAccentSoftBrush" Color="#1FEDEDEA" />
      <SolidColorBrush x:Key="AzAccentTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="AzSuccessBrush" Color="#34D399" />
      <SolidColorBrush x:Key="AzWarningBrush" Color="#FBBF24" />
      <SolidColorBrush x:Key="AzDangerBrush" Color="#F87171" />
      <SolidColorBrush x:Key="AzDangerSoftBrush" Color="#26F87171" />
      <SolidColorBrush x:Key="AzOverlayBrush" Color="#CC000000" />
      <SolidColorBrush x:Key="AzSelectionBrush" Color="#26EDEDEA" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AzWindowBrush" Color="#EDEDEA" />
      <SolidColorBrush x:Key="AzSidebarBrush" Color="#EDEDEA" />
      <SolidColorBrush x:Key="AzSurfaceBrush" Color="#F7F7F5" />
      <SolidColorBrush x:Key="AzSurfaceAltBrush" Color="#E4E4E0" />
      <SolidColorBrush x:Key="AzHoverBrush" Color="#E0E0DC" />
      <SolidColorBrush x:Key="AzBorderBrush" Color="#D2D2CD" />
      <SolidColorBrush x:Key="AzTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="AzMutedBrush" Color="#5E5E5A" />
      <SolidColorBrush x:Key="AzFaintBrush" Color="#8E8E89" />
      <SolidColorBrush x:Key="AzAccentBrush" Color="#000000" />
      <SolidColorBrush x:Key="AzAccentSoftBrush" Color="#14000000" />
      <SolidColorBrush x:Key="AzAccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AzSuccessBrush" Color="#059669" />
      <SolidColorBrush x:Key="AzWarningBrush" Color="#B45309" />
      <SolidColorBrush x:Key="AzDangerBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="AzDangerSoftBrush" Color="#1ADC2626" />
      <SolidColorBrush x:Key="AzOverlayBrush" Color="#99EDEDEA" />
      <SolidColorBrush x:Key="AzSelectionBrush" Color="#1F000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <CornerRadius x:Key="AzCardRadius">12</CornerRadius>
  <CornerRadius x:Key="AzControlRadius">8</CornerRadius>
</ResourceDictionary>
