<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AzWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AzTextBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AzTextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource AzFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource AzFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource AzAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource AzDangerBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource AzSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource AzWarningBrush}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AzSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AzBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource AzCardRadius}" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource AzAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="Border.pill.danger">
    <Setter Property="Background" Value="{DynamicResource AzDangerSoftBrush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource AzControlRadius}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AzAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AzAccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AzAccentTextBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource AzDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Foreground" Value="{DynamicResource AzTextBrush}" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool mi|MaterialIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{DynamicResource AzSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AzBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource AzCardRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AzAccentBrush}" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource AzControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzAccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AzTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AzAccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AzMutedBrush}" />
  </Style>

  <!-- File list -->
  <Style Selector="ListBox.files">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem.droptarget /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AzAccentSoftBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AzAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AzHoverBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource AzControlRadius}" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource AzBorderBrush}" />
  </Style>
</Styles>
